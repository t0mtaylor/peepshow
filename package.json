{
  "name": "peepshow",
  "version": "0.3.1",
  "description": "Turn videos + animated images (GIF/APNG/WebP) into a timeline of still frames so LLMs can 'watch' them. CLI + Claude Code plugin with 19 pluggable sinks (SQLite, Postgres, S3-compatible, Slack, Discord, Webhook, GraphQL, Notion, Obsidian, IDE attachments, Linear, GitHub Issues, Sentry, Chroma, Qdrant, Pinecone, pgvector, MongoDB, MemPalace).",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Tom Taylor",
    "url": "https://x.com/tom_taylor"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "llm",
    "ai",
    "ffmpeg",
    "video",
    "gif",
    "apng",
    "animated-webp",
    "frames",
    "scene-detection",
    "slides",
    "sinks",
    "obsidian",
    "notion",
    "sqlite",
    "postgres",
    "s3",
    "webhook"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0mtaylor/peepshow.git"
  },
  "bugs": {
    "url": "https://github.com/t0mtaylor/peepshow/issues"
  },
  "homepage": "https://www.peepshow.dev/",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "peepshow": "./bin/peepshow",
    "peepshow-sink-sqlite": "./bin/peepshow-sink-sqlite",
    "peepshow-sink-webhook": "./bin/peepshow-sink-webhook",
    "peepshow-sink-slack": "./bin/peepshow-sink-slack",
    "peepshow-sink-discord": "./bin/peepshow-sink-discord",
    "peepshow-sink-obsidian": "./bin/peepshow-sink-obsidian",
    "peepshow-sink-graphql": "./bin/peepshow-sink-graphql",
    "peepshow-sink-ide": "./bin/peepshow-sink-ide",
    "peepshow-sink-postgres": "./bin/peepshow-sink-postgres",
    "peepshow-sink-s3": "./bin/peepshow-sink-s3",
    "peepshow-sink-notion": "./bin/peepshow-sink-notion",
    "peepshow-sink-linear": "./bin/peepshow-sink-linear",
    "peepshow-sink-github-issues": "./bin/peepshow-sink-github-issues",
    "peepshow-sink-sentry": "./bin/peepshow-sink-sentry",
    "peepshow-sink-chroma": "./bin/peepshow-sink-chroma",
    "peepshow-sink-qdrant": "./bin/peepshow-sink-qdrant",
    "peepshow-sink-pinecone": "./bin/peepshow-sink-pinecone",
    "peepshow-sink-pgvector": "./bin/peepshow-sink-pgvector",
    "peepshow-sink-mongodb": "./bin/peepshow-sink-mongodb",
    "peepshow-sink-mempalace": "./bin/peepshow-sink-mempalace"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "better-sqlite3": "^11.0.0",
    "mongodb": "^6.10.0",
    "pg": "^8.12.0"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
